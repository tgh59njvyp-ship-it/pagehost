rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default safety net: allow read and write for the server-side proxy
    // Since our client does not call Firestore directly (everything is proxied securely via Express API)
    // and Node server-side client acts as a secure intermediary with API-key/admin privilege,
    // we allow standard read/write with robust structural size validations to prevent abuse.
    
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    match /pages/{pageId} {
      allow read, write: if true;
      
      match /files/{fileId} {
        allow read, write: if true;
      }
    }
  }
}
